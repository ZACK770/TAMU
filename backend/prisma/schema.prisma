generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  phone           String           @unique
  fullName        String?
  totalPoints     Int              @default(0)
  availablePoints Int              @default(0)
  isActive        Boolean          @default(true)
  adminNotes      String?
  blockedAt       DateTime?
  blockedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  examSessions    ExamSession[]
  redemptions     UserRedemption[]
  pointHistory    PointHistory[]
}

model Exam {
  id             String           @id @default(uuid())
  title          String
  isRandom       Boolean          @default(false)
  studyProgramId String?
  studyProgram   StudyProgram?    @relation(fields: [studyProgramId], references: [id])
  benefits       ExamBenefit[]
  rewardRules    ExamRewardRule[]
  sessions       ExamSession[]
  tokens         ExamToken[]
  questions      Question[]
  allowedBenefits ExamAllowedBenefit[]
}

model Question {
  id         String   @id @default(uuid())
  examId     String
  text       String
  answers    String[]
  correctIdx Int
  exam       Exam     @relation(fields: [examId], references: [id])
}

model ExamToken {
  id        String    @id @default(uuid())
  tokenCode String    @unique
  examId    String
  isUsed    Boolean   @default(false)
  usedById  String?
  usedAt    DateTime?
  exam      Exam      @relation(fields: [examId], references: [id])
}

model ExamSession {
  id           String    @id @default(uuid())
  userId       String
  examId       String
  score        Int?
  answers      Json
  isCompleted  Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  earnedPoints Int       @default(0)
  timeSpent    Int?
  deviceInfo   String?
  exam         Exam      @relation(fields: [examId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
}

model StudyProgram {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   @default("general")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exams       Exam[]
  lessons     Lesson[]
}

model ExamRewardRule {
  id        String   @id @default(uuid())
  examId    String
  minScore  Int
  points    Int
  createdAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamBenefit {
  id          String   @id @default(uuid())
  examId      String
  title       String
  description String?
  costPoints  Int
  createdAt   DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Lesson {
  id             String        @id @default(uuid())
  title          String
  description    String?
  videoUrl       String?
  audioUrl       String?
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  parasha        String?
  studyProgramId String?
  weekDate       DateTime?
  studyProgram   StudyProgram? @relation(fields: [studyProgramId], references: [id])
  materials      Material[]
}

model Material {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  fileType  String
  fileSize  Int
  lessonId  String?
  createdAt DateTime @default(now())
  lesson    Lesson?  @relation(fields: [lessonId], references: [id])
}

model UserRedemption {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  benefitId   String
  benefit     Benefit  @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  pointsUsed  Int
  status      String   @default("pending")
  notes       String?
  redeemedAt  DateTime @default(now())
  processedAt DateTime?
  processedBy String?

  @@unique([userId, benefitId, redeemedAt])
  @@index([userId])
  @@index([benefitId])
  @@index([status])
}

model Benefit {
  id          String           @id @default(uuid())
  title       String
  description String?
  costPoints  Int
  isActive    Boolean          @default(true)
  category    String?
  imageUrl    String?
  maxUses     Int?
  currentUses Int              @default(0)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  redemptions UserRedemption[]
  examAllowedBenefits ExamAllowedBenefit[]
}

model ExamAllowedBenefit {
  id        String   @id @default(uuid())
  examId    String
  benefitId String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  benefit   Benefit  @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([examId, benefitId])
  @@index([examId])
  @@index([benefitId])
}

model PointHistory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  amount      Int
  reason      String?
  description String?
  createdAt   DateTime @default(now())
  createdBy   String?

  @@index([userId])
  @@index([createdAt])
}
